# Variáveis de ambiente para testes
# Copie este arquivo para .env e preencha com suas credenciais

# URL base do Jira (sem barra final)
JIRA_BASE_URL=https://seu-dominio.atlassian.net

# Email da conta do Jira
JIRA_EMAIL=seu-email@exemplo.com

# Token de API do Jira
# Obtenha em: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=seu-token-aqui

# Timezone (opcional, padrão: UTC)
JIRA_USER_TZ=America/Sao_Paulo

# Issue de teste para testes de integração (opcional)
TEST_ISSUE_KEY=PROJ-123

