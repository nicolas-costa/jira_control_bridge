{
  "name": "jira_control_bridge",
  "version": "1.7.0",
  "description": "MCP Server para gerenciar issues, worklogs, comentários, anexos e transições no Jira Cloud",
  "type": "module",
  "repository": "https://github.com/nicolas-costa/jira_control_bridge.git",
  "main": "server.js",
  "bin": {
    "jira-mcp-server": "./server.js"
  },
  "scripts": {
    "build": "node --check server.js && npm run test:unit",
    "start": "node server.js",
    "test": "node --test test/**/*.test.js",
    "test:unit": "node --test test/helpers.test.js",
    "test:integration": "node --test test/integration.test.js test/search-jql.test.js",
    "test:jql": "node --test test/search-jql.test.js",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "dotenv": "^16.6.1"
  }
}
